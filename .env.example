# ==========================================================================
# GESTORDEVENDAS — Front-end (Vite + React)
# Só variáveis com prefixo VITE_ chegam ao navegador.
# NUNCA coloque segredo aqui: tudo isso vai no bundle, visível para o usuário.
# ==========================================================================

# --------------------------------------------------------------------------
# API
# Em desenvolvimento, deixe /api e o Vite faz proxy para VITE_API_PROXY_TARGET
# (mesma origem = cookie httpOnly do refresh token funciona sem dor de cabeça).
# --------------------------------------------------------------------------
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3333
VITE_PORT=5173

# --------------------------------------------------------------------------
# MARCA — troque estes valores para reetiquetar o sistema.
# O logo pode ser um caminho em /public (ex.: /logo.svg) ou uma URL completa.
# Deixe VITE_BRAND_LOGO_URL vazio para usar a marca embutida (SVG do código).
# --------------------------------------------------------------------------
VITE_BRAND_NAME=GestorDeVendas
VITE_BRAND_SHORT_NAME=Gestor
VITE_BRAND_TAGLINE=Gestor de clientes e parque de máquinas
VITE_BRAND_LOGO_URL=
VITE_BRAND_LOGO_DARK_URL=
VITE_BRAND_ICON_URL=
# Cor primária em HEX — vira as variáveis --brand-* em runtime.
VITE_BRAND_PRIMARY_COLOR=#1F6FEB
# Imagem do painel lateral da tela de login (vazio = gradiente da marca)
VITE_LOGIN_BACKGROUND_URL=
VITE_SUPPORT_EMAIL=suporte@gestordevendas.com.br

# --------------------------------------------------------------------------
# COMPORTAMENTO
# --------------------------------------------------------------------------
# Mostra o seletor de empresa no login. Desligue em instalação de cliente único
# e informe o CNPJ fixo em VITE_FIXED_CNPJ.
VITE_ENABLE_COMPANY_SELECT=true
VITE_FIXED_CNPJ=
